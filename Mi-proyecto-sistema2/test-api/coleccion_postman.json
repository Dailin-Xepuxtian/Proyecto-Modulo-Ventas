    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Login correcto (administrador)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Devuelve token JWT tipo Bearer', () => { pm.expect(j.token).to.be.a('string'); pm.expect(j.tipo).to.eql('Bearer'); });",
                  "pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Ejecutar primero: guarda el token en la variable {{token}}. Requiere haber corrido tools/actualizar_passwords.php",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"kquinteros@giganet.com.gt\",\n  \"password\": \"Manager1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
