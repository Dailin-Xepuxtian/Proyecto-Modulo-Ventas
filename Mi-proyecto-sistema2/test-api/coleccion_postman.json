    {
      "name": "3. Cotizaciones (POST / GET)",
      "item": [
        {
          "name": "POST /cotizaciones (camino feliz)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('Número con formato COT-YYYYMMDD-HHMMSS', () => pm.expect(j.numeroCotizacion).to.match(/^COT-\\d{8}-\\d{6}$/));",
                  "pm.test('Estado inicial PENDIENTE', () => pm.expect(j.estado).to.eql('PENDIENTE'));",
                  "pm.test('Subtotal = 2x650 + 1x1750 = 3050', () => pm.expect(j.subtotal).to.eql(3050));",
                  "pm.test('IVA 12% = 366', () => pm.expect(j.iva).to.eql(366));",
                  "pm.test('Total = subtotal + IVA = 3416', () => pm.expect(j.total).to.eql(3416));",
                  "pm.test('Trae 2 items', () => pm.expect(j.items.length).to.eql(2));",
                  "pm.collectionVariables.set('cotizacionId', j.id);",
                  "pm.collectionVariables.set('numeroCotizacion', j.numeroCotizacion);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cotizaciones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cotizaciones"
              ]
            },
            "description": "Producto 1 (Cámara Hikvision Q650) x2 + Producto 2 (NVR Q1,750) x1. Guarda el id en {{cotizacionId}}.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": {\n    \"nombre\": \"María\",\n    \"apellido\": \"López\",\n    \"correo\": \"maria.lopez@correo.com\",\n    \"nit\": \"1234567-8\"\n  },\n  \"items\": [\n    {\n      \"productoId\": 1,\n      \"cantidad\": 2\n    },\n    {\n      \"productoId\": 2,\n      \"cantidad\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "GET /cotizaciones/{id} (consultar la creada)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Es la misma cotización creada', () => pm.expect(pm.response.json().numeroCotizacion).to.eql(pm.collectionVariables.get('numeroCotizacion')));",
                  "pm.test('Vencimiento posterior a la emisión', () => { const j = pm.response.json(); pm.expect(new Date(j.fechaVencimiento) > new Date(j.fechaCotizacion)).to.be.true; });"
                ]
              }
            }
