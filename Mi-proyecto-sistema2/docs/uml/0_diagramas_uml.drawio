        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml ecommerce_redes_paquetes\ntitle E-commerce de Dispositivos de Red - Diagrama de Paquetes\nskinparam packageStyle rectangle\nleft to right direction\n\npackage \&quot;Presentacion\&quot; {\n  [Portal Web Clientes]\n  [Panel de Administracion]\n}\n\npackage \&quot;Seguridad\&quot; {\n  [Control de Usuarios]\n  [Roles y Permisos]\n}\n\npackage \&quot;Catalogo\&quot; {\n  [Gestión de Productos de Red]\n  [Categorías]\n}\n\npackage \&quot;Inventario\&quot; {\n  [Control de Stock]\n  [Bodegas]\n}\n\npackage \&quot;Clientes\&quot; {\n  [Perfiles de Clientes]\n}\n\npackage \&quot;Proveedores\&quot; {\n  [Proveedores de Hardware]\n}\n\npackage \&quot;Cotizaciones\&quot; {\n  [Cotizaciones y Órdenes]\n  [Detalle de Cotización]\n}\n\npackage \&quot;Pagos\&quot; {\n  [Procesador de Pagos]\n  [Pasarela Externa]\n}\n\npackage \&quot;Envio\&quot; {\n  [Documentos de Envío]\n  [Guías de Transporte]\n}\n\npackage \&quot;Infraestructura\&quot; {\n  database \&quot;Base de Datos\&quot; as BD\n  [Capa de Persistencia / ORM]\n}\n\n&#39; Relaciones principales entre módulos\n[Portal Web Clientes] --&gt; Cotizaciones : &lt;&lt;use&gt;&gt;\n[Portal Web Clientes] --&gt; Catalogo : &lt;&lt;use&gt;&gt;\n[Panel de Administracion] --&gt; Seguridad : &lt;&lt;use&gt;&gt;\n\nCotizaciones ..&gt; Catalogo : &lt;&lt;use&gt;&gt;\nCotizaciones ..&gt; Clientes : &lt;&lt;use&gt;&gt;\nCotizaciones --&gt; Pagos : &lt;&lt;use&gt;&gt;\nPagos --&gt; Envio : &lt;&lt;triggers&gt;&gt;\n\nInventario ..&gt; Catalogo : &lt;&lt;updates&gt;&gt;\nProveedores ..&gt; Catalogo : &lt;&lt;supplies&gt;&gt;\n\n&#39; Dependencias de infraestructura\nSeguridad ..&gt; Infraestructura : &lt;&lt;import&gt;&gt;\nCatalogo ..&gt; Infraestructura : &lt;&lt;import&gt;&gt;\nInventario ..&gt; Infraestructura : &lt;&lt;import&gt;&gt;\nClientes ..&gt; Infraestructura : &lt;&lt;import&gt;&gt;\nProveedores ..&gt; Infraestructura : &lt;&lt;import&gt;&gt;\nCotizaciones ..&gt; Infraestructura : &lt;&lt;import&gt;&gt;\nPagos ..&gt; Infraestructura : &lt;&lt;import&gt;&gt;\nEnvio ..&gt; Infraestructura : &lt;&lt;import&gt;&gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="b4oDMdWbW7zOYCgxBEqg-1">
