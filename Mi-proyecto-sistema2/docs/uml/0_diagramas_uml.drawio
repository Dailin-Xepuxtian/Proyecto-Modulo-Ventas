        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml ecommerce_redes_clases\ntitle E-commerce de Dispositivos de Red - Diagrama de Clases UML\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\nhide empty members\n\nclass Usuario {\n  + idUsuario: int\n  + email: string\n  + passwordHash: string\n  + estado: boolean\n  + login(): boolean\n  + logout(): void\n  + verificarPermisos(): boolean\n}\n\nclass Rol {\n  + idRol: int\n  + nombreRol: string\n  + asignarPermiso(): void\n}\n\nclass Permiso {\n  + idPermiso: int\n  + codigo: string\n  + descripcion: string\n}\n\nclass Categoria {\n  + idCategoria: int\n  + nombre: string\n  + descripcion: string\n  + listarProductos(): void\n}\n\nclass ProductoRed {\n  + codigo: string\n  + nombre: string\n  + marca: string\n  + modelo: string\n  + precio: float\n  + tipoDispositivo: string\n  + actualizarPrecio(): void\n}\n\nclass Inventario {\n  + idInventario: int\n  + stockActual: int\n  + stockMinimo: int\n  + verificarStock(): boolean\n  + actualizarStock(cantidad: int): void\n}\n\nclass Bodega {\n  + idBodega: int\n  + nombre: string\n  + ubicacion: string\n}\n\nclass Cliente {\n  + idCliente: int\n  + razonSocial: string\n  + ruc: string\n  + correo: string\n  + telefono: string\n  + registrar(): void\n  + actualizarPerfil(): void\n}\n\nclass Proveedor {\n  + idProveedor: int\n  + nombreEmpresa: string\n  + contacto: string\n  + telefono: string\n  + proveerProductos(): void\n}\n\nclass Cotizacion {\n  + idCotizacion: int\n  + fecha: Date\n  + total: float\n  + estado: string\n  + calcularTotal(): float\n  + aprobar(): boolean\n}\n\nclass DetalleCotizacion {\n  + cantidad: int\n  + precioUnitario: float\n  + subtotal: float\n  + calcularSubtotal(): float\n}\n\nclass Pago {\n  + idPago: int\n  + metodo: string\n  + monto: float\n  + estado: string\n  + procesarPago(): boolean\n  + reembolsar(): boolean\n}\n\nclass Envio {\n  + idEnvio: int\n  + empresaTransporte: string\n  + codigoGuia: string\n  + estadoEnvio: string\n  + generarGuia(): void\n  + rastrearEnvio(): string\n}\n\n&#39; --- RELACIONES ---\n\n&#39; Autenticación y seguridad\nUsuario \&quot;*\&quot; o-- \&quot;1\&quot; Rol : tiene &gt;\nRol \&quot;*\&quot; o-- \&quot;*\&quot; Permiso : agrupa &gt;\n\n&#39; Catálogo e Inventario\nCategoria \&quot;1\&quot; *-- \&quot;*\&quot; ProductoRed : contiene &gt;\nBodega \&quot;1\&quot; *-- \&quot;*\&quot; Inventario : almacena &gt;\nProductoRed \&quot;1\&quot; -- \&quot;1\&quot; Inventario : gestiona stock &gt;\nProveedor \&quot;1\&quot; -- \&quot;*\&quot; ProductoRed : suministra &gt;\n\n&#39; Clientes y Cotizaciones\nCliente \&quot;1\&quot; -- \&quot;0..*\&quot; Cotizacion : solicita &gt;\nCotizacion \&quot;1\&quot; *-- \&quot;1..*\&quot; DetalleCotizacion : compone &gt;\nDetalleCotizacion \&quot;*\&quot; --&gt; \&quot;1\&quot; ProductoRed : referencia &gt;\n\n&#39; Pagos y Envíos\nCotizacion \&quot;1\&quot; -- \&quot;0..1\&quot; Pago : se paga con &gt;\nPago \&quot;1\&quot; -- \&quot;0..1\&quot; Envio : genera &gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TzfF4bAxo7P9rbKCoduZ-1">
