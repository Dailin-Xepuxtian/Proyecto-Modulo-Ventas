  <diagram id="5f-LE2-aml8zb_JOl6Jy" name="secuencia_pago-envio">
    <mxGraphModel dx="2719" dy="1494" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml secuencia_pago_envio\ntitle Modulo Ventas - Secuencia: Pago y creacion de documento de envio\nautonumber\nactor Vendedor\nparticipant \&quot;PagoEnvioController\&quot; as C\nparticipant \&quot;PagoEnvioService\&quot; as S\nparticipant \&quot;CotizacionRepository\&quot; as CR\nparticipant \&quot;AutorizacionService\&quot; as A\nparticipant \&quot;DocumentoEnvioRepository\&quot; as DR\nparticipant \&quot;ProcesadorPago\&quot; as PP\nparticipant \&quot;EstrategiaPago\\n(Efectivo / Referencia / Tarjeta)\&quot; as E\nparticipant \&quot;PasarelaPago\\n(simulacion)\&quot; as PG\ndatabase \&quot;BD\&quot; as DB\n\nVendedor -&gt; C : POST /cotizaciones/{id}/pago-envio\nC -&gt; S : ejecutar(id, usuario, solicitud)\nS -&gt; CR : buscarPorId(id)\nCR --&gt; S : cotizacion | null\n\nalt la cotizacion no existe\n  S --&gt; C : CotizacionNoEncontrada\n  C --&gt; Vendedor : 404 Not Found\nelse existe\n  S -&gt; A : tienePermiso(usuario, \&quot;pago_envio\&quot;, cotizacion)\n  A --&gt; S : true | false\n  alt sin permisos\n    S --&gt; C : SinPermiso\n    C --&gt; Vendedor : 403 Forbidden\n  else con permisos\n    alt estado = RECHAZADA o CONVERTIDA_A_VENTA\n      S --&gt; C : EstadoNoPermitido\n      C --&gt; Vendedor : 422 Unprocessable Entity\n    else estado valido\n      S -&gt; DR : existePorCotizacion(id_cotizacion)\n      DR -&gt; DB : SELECT ... WHERE id_cotizacion = ?\n      DB --&gt; DR : fila | vacio\n      DR --&gt; S : existe\n      alt ya existe documento\n        S --&gt; C : DocumentoDuplicado\n        C --&gt; Vendedor : 409 Conflict\n      else no existe documento\n        S -&gt; PP : setEstrategia(segun metodo)\n        S -&gt; PP : procesar(monto, datos)\n        PP -&gt; E : pagar(monto, datos)\n        opt metodo = Tarjeta\n          E -&gt; PG : autorizar(datos, monto)\n          PG --&gt; E : ResultadoPago\n        end\n        E --&gt; PP : ResultadoPago\n        PP --&gt; S : ResultadoPago\n        alt pago rechazado (tarjeta)\n          S --&gt; C : PagoRechazado (sin crear documento)\n          C --&gt; Vendedor : 400 Bad Request\n        else pago aprobado\n          S -&gt; DR : crear(documentoEnvio)\n          DR -&gt; DB : INSERT documento_envio\n          DB --&gt; DR : ok\n          DR --&gt; S : documento\n          S --&gt; C : documento\n          C --&gt; Vendedor : 201 Created\n        end\n      end\n    end\n  end\nend\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_QB4GbLfU2Az4GQOGcsO-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
