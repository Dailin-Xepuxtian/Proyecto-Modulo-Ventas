      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml sistema_paquetes_global\ntitle Diagrama de Paquetes - Arquitectura Global del Sistema (Tienda de Redes)\nskinparam packageStyle rectangle\nleft to right direction\n\npackage \&quot;Presentación / Interfaz de Usuario\&quot; {\n  [Portal Web Clientes / E-commerce]\n  [Panel de Administración (Backoffice)]\n}\n\npackage \&quot;Módulo de Catálogo e Inventario\&quot; {\n  [Gestión de Productos (Dispositivos de Red)]\n  [Categorías y Especificaciones]\n  [Control de Stock / Bodega]\n}\n\npackage \&quot;Módulo de Ventas y Pedidos\&quot; {\n  [Cotizaciones y Carrito]\n  [Órdenes de Compra]\n  [Detalle de Transacciones]\n}\n\npackage \&quot;Módulo de Pagos y Envíos\&quot; {\n  [Procesador de Pagos (Strategies)]\n  [Pasarela Externa]\n  [Documentos de Envío / Guías]\n}\n\npackage \&quot;Gestión de Clientes (CRM)\&quot; {\n  [Registro y Perfiles]\n  [Historial de Compras]\n}\n\npackage \&quot;Módulo de Compras y Proveedores\&quot; {\n  [Órdenes a Proveedores (Reabastecimiento)]\n  [Recepción de Mercadería]\n}\n\npackage \&quot;Seguridad y Control de Acceso\&quot; {\n  [Gestión de Usuarios]\n  [Roles y Permisos]\n  [Autenticación y Sesiones]\n}\n\npackage \&quot;Reportes y Analítica\&quot; {\n  [Reportes de Ventas]\n  [Métricas de Inventario]\n}\n\npackage \&quot;Infraestructura y Persistencia\&quot; {\n  database \&quot;Base de Datos Central\&quot; as BD\n  [Capa de Repositorios / ORM]\n}\n\n&#39; --- DEPENDENCIAS PRINCIPALES ENTRE MÓDULOS ---\n[Portal Web Clientes / E-commerce] --&gt; \&quot;Módulo de Catálogo e Inventario\&quot; : &lt;&lt;use&gt;&gt;\n[Portal Web Clientes / E-commerce] --&gt; \&quot;Módulo de Ventas y Pedidos\&quot; : &lt;&lt;use&gt;&gt;\n[Panel de Administración (Backoffice)] --&gt; \&quot;Módulo de Compras y Proveedores\&quot; : &lt;&lt;use&gt;&gt;\n[Panel de Administración (Backoffice)] --&gt; \&quot;Reportes y Analítica\&quot; : &lt;&lt;use&gt;&gt;\n\n\&quot;Módulo de Ventas y Pedidos\&quot; ..&gt; \&quot;Módulo de Catálogo e Inventario\&quot; : &lt;&lt;use&gt;&gt;\n\&quot;Módulo de Ventas y Pedidos\&quot; ..&gt; \&quot;Gestión de Clientes (CRM)\&quot; : &lt;&lt;use&gt;&gt;\n\&quot;Módulo de Ventas y Pedidos\&quot; --&gt; \&quot;Módulo de Pagos y Envíos\&quot; : &lt;&lt;use&gt;&gt;\n\n\&quot;Módulo de Pagos y Envíos\&quot; ..&gt; \&quot;Seguridad y Control de Acceso\&quot; : &lt;&lt;use&gt;&gt;\n\&quot;Módulo de Ventas y Pedidos\&quot; ..&gt; \&quot;Seguridad y Control de Acceso\&quot; : &lt;&lt;use&gt;&gt;\n[Panel de Administración (Backoffice)] ..&gt; \&quot;Seguridad y Control de Acceso\&quot; : &lt;&lt;use&gt;&gt;\n\n\&quot;Módulo de Compras y Proveedores\&quot; --&gt; \&quot;Módulo de Catálogo e Inventario\&quot; : &lt;&lt;update stock&gt;&gt;\n\&quot;Reportes y Analítica\&quot; ..&gt; \&quot;Módulo de Ventas y Pedidos\&quot; : &lt;&lt;use&gt;&gt;\n\&quot;Reportes y Analítica\&quot; ..&gt; \&quot;Módulo de Catálogo e Inventario\&quot; : &lt;&lt;use&gt;&gt;\n\n&#39; --- CAPA DE INFRAESTRUCTURA ---\n\&quot;Módulo de Catálogo e Inventario\&quot; ..&gt; \&quot;Infraestructura y Persistencia\&quot; : &lt;&lt;import&gt;&gt;\n\&quot;Módulo de Ventas y Pedidos\&quot; ..&gt; \&quot;Infraestructura y Persistencia\&quot; : &lt;&lt;import&gt;&gt;\n\&quot;Módulo de Pagos y Envíos\&quot; ..&gt; \&quot;Infraestructura y Persistencia\&quot; : &lt;&lt;import&gt;&gt;\n\&quot;Gestión de Clientes (CRM)\&quot; ..&gt; \&quot;Infraestructura y Persistencia\&quot; : &lt;&lt;import&gt;&gt;\n\&quot;Módulo de Compras y Proveedores\&quot; ..&gt; \&quot;Infraestructura y Persistencia\&quot; : &lt;&lt;import&gt;&gt;\n\&quot;Seguridad y Control de Acceso\&quot; ..&gt; \&quot;Infraestructura y Persistencia\&quot; : &lt;&lt;import&gt;&gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="-UKAoqMdKwfQzT51vcJp-1">
