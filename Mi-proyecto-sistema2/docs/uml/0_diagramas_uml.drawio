        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml actividades_swimlanes\ntitle Modulo Ventas - Diagrama de Actividades con calles de responsabilidad\n|Vendedor|\nstart\n:Solicita pago-envio de una cotizacion;\n:Selecciona metodo de pago;\n\n|Controlador / Servicio|\n:Recibe la solicitud;\n:Busca la cotizacion;\nif (¿Existe la cotizacion?) then (no)\n  :Responde 404;\n  stop\nelse (si)\nendif\n:Verifica permisos del usuario;\nif (¿Tiene permisos?) then (no)\n  :Responde 403;\n  stop\nelse (si)\nendif\nif (¿Rechazada o convertida a venta?) then (si)\n  :Responde 422;\n  stop\nelse (no)\nendif\n\n|Base de datos|\n:Consulta documento por id_cotizacion;\n\n|Controlador / Servicio|\nif (¿Ya existe documento?) then (si)\n  :Responde 409;\n  stop\nelse (no)\nendif\n\n|ProcesadorPago|\n:Selecciona estrategia de pago;\nif (¿Metodo?) then (Efectivo)\n  :EfectivoStrategy;\nelseif (Referencia) then\n  :ReferenciaBancariaStrategy;\nelse (Tarjeta)\n  :TarjetaStrategy;\n  :PasarelaPago (simulacion);\nendif\n:Genera ResultadoPago;\n\n|Controlador / Servicio|\nif (¿Pago aprobado?) then (no)\n  :Responde 400\\n(no crea documento de envio);\n  stop\nelse (si)\nendif\n\n|Base de datos|\n:Registra pago;\n:Crea documento de envio;\n\n|Controlador / Servicio|\n:Responde 201 Created;\n\n|Vendedor|\n:Recibe confirmacion y documento;\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Rj6M2dbDTdDnW64a9c2q-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
