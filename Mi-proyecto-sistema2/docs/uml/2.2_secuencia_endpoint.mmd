sequenceDiagram
    autonumber
    actor C as Cliente HTTP<br/>(Postman / Interfaz)
    participant R as Router<br/>(public/index.php)
    participant J as Jwt
    participant CC as CotizacionController
    participant D as CotizacionRequest<br/>(DTO)
    participant S as CotizacionService
    participant PR as ProductoRepository
    participant CR as ClienteRepository
    participant QR as CotizacionRepository
    participant DB as MySQL<br/>(giganet_db)

    C->>R: POST /cotizaciones<br/>Authorization: Bearer JWT + JSON
    R->>J: decode(token)
    alt Token ausente, inválido o expirado
        J-->>R: HttpException
        R-->>C: 401 Unauthorized
    end
    J-->>R: payload (sub, rol)
    R->>CC: crear(params, auth)
    CC->>D: fromArray(cuerpo JSON)
    alt Datos inválidos / carrito vacío / cantidad ≤ 0
        D-->>CC: HttpException
        CC-->>C: 400 Bad Request (detalles)
    end
    D-->>CC: CotizacionRequest válido
    CC->>S: crear(dto, idUsuario)
    S->>PR: buscarPorIds(ids)
    PR->>DB: SELECT productos + producto_inventario
    DB-->>PR: filas
    PR-->>S: productos con precio y existencia
    alt Producto sin stock o cantidad > existencia (RN-01, RN-02)
        S-->>CC: HttpException
        CC-->>C: 400 REGLA_DE_NEGOCIO
    end
    Note over S: Calcula subtotal, IVA 12 % y total<br/>(RN-04 / RN-14)
    S->>DB: BEGIN
    S->>CR: buscarPorEmail(correo)
    CR->>DB: SELECT clientes
    opt El cliente no existe
        S->>CR: crear(nombre, nit, correo)
        CR->>DB: INSERT clientes
    end
    S->>QR: insertar(COT-YYYYMMDD-HHMMSS, totales)
    QR->>DB: INSERT cotizaciones
    loop Por cada producto del carrito
        S->>QR: insertarDetalle(linea)
        QR->>DB: INSERT detalle_cotizaciones
    end
    S->>DB: COMMIT
    S->>QR: obtenerPorId(id) + obtenerDetalle(id)
    QR->>DB: SELECT cotización, cliente y detalle
    DB-->>QR: filas
    QR-->>S: datos
    S-->>CC: Cotizacion (JSON del contrato)
    CC-->>C: 201 Created
